{
  "name": "evolv-product-launch",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Example FrameDiff pipeline — moodboard, script, and storyboard drive a set of generative comps (Seedream stills, Seedance clips, Seed Audio VO) cut together in an overlay-driven launch edit for the Evolv28 wearable.",
  "scripts": {
    "prepare": "svelte-kit sync",
    "dev": "vite dev",
    "build": "vite build",
    "check:bundles": "node scripts/check-bundle-budgets.mjs",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && npm run check:registry",
    "check:registry": "node scripts/check-composition-registry.mjs",
    "audit": "npm audit --audit-level=high",
    "typecheck": "npm run check"
  },
  "dependencies": {
    "@babel/parser": "^8.0.4",
    "framediff-monorepo": "github:micromanager3000/framediff#b213107d381db8db9daf98f18dbda0360ffac6c1",
    "gsap": "^3.15.0",
    "mediabunny": "^1.53.1",
    "mp4-muxer": "^5.2.2",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^26.2.0",
    "@types/three": "^0.185.4",
    "@webgpu/types": "^0.1.71",
    "svelte": "^5.56.9",
    "svelte-check": "^4.7.5",
    "typescript": "^6.0.3",
    "vite": "^8.2.1"
  }
}
